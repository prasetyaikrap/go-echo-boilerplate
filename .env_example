PORT=3005
CLIENT_ID=GO_BOILERPLATE
ALLOWED_CLIENT_IDS=
ALLOWED_ORIGINS=

SERVICE_TOKEN=xxxxxx
JWT_ACCESS_SECRET=xxxxxx
JWT_REFRESH_SECRET=xxxxxx
ACCESS_TOKEN_EXPIRATION=15
REFRESH_TOKEN_EXPIRATION=43200

# Deadline for each HTTP request in seconds (database/cache calls are cancelled after it). 0 disables it
REQUEST_TIMEOUT=30
# Seconds to wait for in-flight requests to finish on shutdown
SHUTDOWN_TIMEOUT=10

# HTTP server connection timeouts in seconds
# Closes connections that do not send request headers in time (slowloris protection). Enabled by default; 0 disables it (not recommended)
SERVER_READ_HEADER_TIMEOUT=10
# Optional, empty or 0 disables them. Usually unnecessary behind a reverse proxy / load balancer
# Whole request incl. body (large uploads on slow networks can hit it)
SERVER_READ_TIMEOUT=
# Until the response is fully written. Cuts off streaming (SSE) responses
SERVER_WRITE_TIMEOUT=
# Idle keep-alive connections. Empty falls back to SERVER_READ_TIMEOUT
SERVER_IDLE_TIMEOUT=

# Maximum request body size, e.g. 10M, 512K, 1G (413 when exceeded). 0 disables it
REQUEST_BODY_LIMIT=10M

DB_DSN="host= user= password= dbname= port= sslmode= TimeZone="
DB_MAX_CONN_IDLE=10
DB_MAX_CONN_IDLE_LIFETIME=30
DB_MAX_CONN=25
DB_MAX_CONN_LIFETIME=60
DB_AUTO_MIGRATE=
# GORM SQL log level: silent;error;warn;info
DB_LOG_LEVEL=info
# Additional databases use the same keys with their own prefix, e.g. ANALYTICS_DB_DSN, ANALYTICS_DB_MAX_CONN

# MongoDB
# URI format: mongodb://<user>:<password>@<host>:<port>/?authSource=admin (mongodb+srv:// for Atlas)
# Additional databases use the same keys with their own prefix, e.g. AUDIT_MONGO_URI
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=
# Empty uses the driver default (100)
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=
# Close connections idle longer than this, in minutes. Empty means no limit
MONGO_MAX_CONN_IDLE_TIME=
# Connect, server selection and startup ping timeout in seconds
MONGO_CONNECT_TIMEOUT=10
# true to create the registered indexes on startup
MONGO_AUTO_MIGRATE=

# Redis
# URL format: redis://<user>:<password>@<host>:<port>/<db> (use rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=
# Default cache TTL in minutes
REDIS_DEFAULT_TTL=60
REDIS_POOL_SIZE=
# Startup connection check timeout in seconds
REDIS_PING_TIMEOUT=5

# STOMP Message Broker (ActiveMQ, RabbitMQ STOMP plugin, Artemis, etc.)
# Additional connections use the same keys with their own prefix, e.g. EVENTS_STOMP_ADDRESS
STOMP_ADDRESS=localhost:61613
STOMP_LOGIN=
STOMP_PASSCODE=
# Virtual host. RabbitMQ: / . Empty uses the host part of STOMP_ADDRESS
STOMP_HOST=
STOMP_USE_TLS=
# Heart-beat interval in seconds
STOMP_HEARTBEAT=10
# Dial and handshake timeout in seconds
STOMP_CONNECT_TIMEOUT=10
# Wait between reconnect attempts in seconds. 0 disables auto-reconnect
STOMP_RECONNECT_INTERVAL=5

# S3-compatible Storage (AWS S3, Cloudflare R2, MinIO, etc.)
# AWS S3: leave S3_ENDPOINT empty, set S3_REGION (e.g. ap-southeast-1)
# Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# MinIO: S3_ENDPOINT=http://localhost:9000, S3_USE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_HOST=
S3_BASE_FOLDER=
S3_USE_PATH_STYLE=
# Default presigned URL expiration in minutes
S3_PRESIGN_EXPIRE=15

# Local Storage (file cache, generated files, local config). In Docker, mount a volume at LOCAL_STORAGE_BASE_DIR
# Additional directories use the same keys with their own prefix, e.g. CACHE_STORAGE_BASE_DIR
LOCAL_STORAGE_BASE_DIR=storage
# Octal permissions for created directories and files
LOCAL_STORAGE_DIR_MODE=0755
LOCAL_STORAGE_FILE_MODE=0644

# LLM Configuration (main LLM). Additional LLMs use the same keys with their own prefix, e.g. FAST_LLM_PROVIDER
# Provider: ollama;gemini;openai;anthropic. Empty disables LangChain
LLM_PROVIDER=ollama
# Empty uses the provider default: llama3.1 (ollama), claude-opus-5-5 (anthropic). Required for gemini and openai
LLM_MODEL=
LLM_OLLAMA_SERVER_URL=http://localhost:11434
# API key of the selected provider (gemini, openai, anthropic)
LLM_API_KEY=
LLM_CONTEXT_WINDOW_SIZE=
# Sampling temperature, e.g. 0.2. Empty keeps the provider default. Ignored by anthropic (Claude rejects it)
LLM_TEMPERATURE=
# Anthropic only: reasoning effort low;medium;high;xhigh;max
LLM_EFFORT=high
# Anthropic only: re-run declined requests on Anthropic's recommended fallback model
LLM_REFUSAL_FALLBACK=true