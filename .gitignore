# Compiled binaries and object files
*.exe
*.dll
*.so
*.dylib
*.o
*.obj

# Go binaries (for your project itself)
# These are the executables generated by `go build` or `go install`
# For Windows
*.exe
# For Linux/macOS (common Go build output names)
# If your main executable is 'your-project-name' for example
# /your-project-name
# You might want to be more specific if you have multiple binaries
# e.g., /cmd/api/api
# /cmd/cli/cli
# Or just ignore all binaries in the root and cmd/ directories
# Go test binaries
/*.test
# Go test output files
/*.out

# Dependency directories
# If you use Go Modules in 'vendor' mode (go mod vendor)
vendor/

# Editor/IDE specific files
# JetBrains IDEs (GoLand, IntelliJ)
.idea/
# VS Code (settings, launch configs)
.vscode/
# Sublime Text
*.sublime-project
*.sublime-workspace
# macOS Finder
.DS_Store
# Windows thumbnails
Thumbs.db
ehthumbs.db
# Eclipse
.settings/
.project
.classpath

# Build artifacts
# These are often generated by build tools or temporary files
dist/
build/
# Common directory for output binaries
bin/
# Temporary files
tmp/
# Log files
log/

# Generated files
# For Go Swag (OpenAPI documentation generator)
# Contains swagger.json, swagger.yaml, doc.go generated by Swag
# /docs/ is NOT ignored: main.go imports the generated docs package, so it must be committed for the app to build
# For Go Wire (Dependency Injection)
# Generated by Wire
wire_gen.go
# For Protobuf/gRPC
# Generated Protobuf Go files
*.pb.go

# Environment variables and secrets
# Environment variables (e.g., used by dotenv)
.env
.env.*
# More general pattern for env files
*.env
# Database connection string (sometimes stored in a file)
.DSN

# Test related files
# If you store test data in a specific directory that shouldn't be versioned
# testdata/ is NOT ignored: by Go convention it holds test fixtures that must be committed

# Crash logs and diagnostics
*.log
*.trace
*.dump

# macOS specific
.DS_Store

# Windows specific
Thumbs.db
Desktop.ini

# Linux specific
# Vim swap files
*.swp
# Emacs backup files
*~
# If you run your app as a service and it creates a PID file
*.pid

.env

# Local storage data (LOCAL_STORAGE_BASE_DIR default)
/storage/
